<?xml version="1.0" encoding="UTF-8"?>
<extension disabled="true" type="plugin" group="blc" method="upgrade">
  <name>plg_blc_cfcontent</name>
  <author>Bram Brambring</author>
  <creationDate>2024-01-01</creationDate>
  <copyright>(C) 2023 - 2024  Bram Brambring</copyright>
  <license>GNU General Public License version 3 or later</license>
  <authorEmail>bram@brokenlinkchecker.dev</authorEmail>
  <authorUrl>brambring.nl</authorUrl>
  <version>24.44.dev</version>
  <description>PLG_BLC_CFCONTENT_XML_DESCRIPTION</description>
  <namespace path="src">Blc\Plugin\Blc\CfContent</namespace>
  <scriptfile>script.php</scriptfile>
  <languages folder="language">
    <language tag="en-GB">en-GB/plg_blc_cfcontent.sys.ini</language>
    <language tag="nl-NL">nl-NL/plg_blc_cfcontent.sys.ini</language>
  </languages>
  <files>
    <folder plugin="cfcontent">services</folder>
    <folder>src</folder>
  </files>
  <config>
    <fields name="params">
      <fieldset name="basic" addfieldprefix="Blc\Component\Blc\Administrator\Field">
        <field name="field_state" disabled="true" type="radio" label="COM_BLC_PLUGIN_PUBLISHED_LBL" default="1" layout="joomla.form.field.radio.switcher" filter="integer">
          <option value="0">Off</option>
          <option value="1">On</option>
        </field>
        <field name="editor" disabled="true" type="radio" label="Extract from Editor type" default="1" layout="joomla.form.field.radio.switcher" filter="integer">
          <option value="0">Off</option>
          <option value="1">On</option>
        </field>
        <field name="textarea" disabled="true" type="radio" label="Extract from Textarea type" default="0" layout="joomla.form.field.radio.switcher" filter="integer">
          <option value="0">Off</option>
          <option value="1">On</option>
        </field>
        <field name="text" disabled="true" type="radio" label="Extract from Text type" default="0" layout="joomla.form.field.radio.switcher" filter="integer">
          <option value="0">Off</option>
          <option value="1">On</option>
        </field>
        <field name="media" disabled="true" type="radio" label="Extract from Media type" default="1" layout="joomla.form.field.radio.switcher" filter="integer">
          <option value="0">Off</option>
          <option value="1">On</option>
        </field>
        <field name="url" disabled="true" type="radio" label="Extract from Url type" default="1" layout="joomla.form.field.radio.switcher" filter="integer">
          <option value="0">Off</option>
          <option value="1">On</option>
        </field>
        <field name="extraurl" disabled="true" type="text" label="Treat fields as Link (ids)" default="" filter="string"/>

    
        <field name="subform" disabled="true" type="radio" label="Parse subforms (beta)" description="PLG_SYSTEM_BLC_BETA_DESC" default="0" layout="joomla.form.field.radio.switcher" filter="integer">
          <option value="0">Off</option>
          <option value="1">On</option>
        </field>
        <field name="info" disabled="true" type="Info" tag="p" class="Blc\Plugin\Blc\CfContent\Extension\BlcPluginActor"/>
      </fieldset>
      <fieldset name="advanced">
        <field name="access" disabled="true" type="list" label="COM_BLC_PLUGIN_ACCESS_LBL" default="-1" filter="integer">
          <option value="-1">JGLOBAL_USE_GLOBAL</option>
          <option value="0">JOff</option>
          <option value="1">JOn</option>
        </field>
        <field name="published" disabled="true" type="list" label="COM_BLC_PLUGIN_PUBLISHED_LBL" default="-1" filter="integer">
          <option value="-1">JGLOBAL_USE_GLOBAL</option>
          <option value="0">JOff</option>
          <option value="1">JOn</option>
        </field>
        <field name="onsave" disabled="true" type="list" label="COM_BLC_PLUGIN_ONSAVE_LBL" default="default">
          <option value="default">JGLOBAL_USE_GLOBAL</option>
          <option value="parse">COM_BLC_PLUGIN_DO_PARSE</option>
          <option value="delete">COM_BLC_PLUGIN_DO_DELETE</option>
          <option value="nothing">COM_BLC_PLUGIN_DO_NOTHING</option>
        </field>
        <field name="ondelete" disabled="true" type="list" label="COM_BLC_PLUGIN_ONDELETE_LBL" default="default">
          <option value="default">JGLOBAL_USE_GLOBAL</option>
          <option value="delete">COM_BLC_PLUGIN_DO_DELETE</option>
          <option value="nothing">COM_BLC_PLUGIN_DO_NOTHING</option>
        </field>
        <field name="deleteonsavepugin" filter="integer" default="-1" disabled="true" type="list" label="COM_BLC_PLUGIN_DELETEONSAVEPUGIN_LBL">
          <option value="-1">JGLOBAL_USE_GLOBAL</option>
          <option value="0">JOff</option>
          <option value="1">JOn</option>
        </field>
        <field name="info" disabled="true" type="Info" tag="p" class="Blc\Plugin\Blc\CfContent\Extension\BlcPluginActor"/>
      </fieldset>
    </fields>
  </config>
  <updateservers>
    <server name="brokenlinkchecker.dev"  type="collection">https://downloads.brokenlinkchecker.dev/blc.xml</server>
  </updateservers>
</extension>
