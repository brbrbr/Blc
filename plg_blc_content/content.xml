<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="blc" method="upgrade">
  <name>plg_blc_content</name>
  <author>Bram Brambring</author>
  <creationDate>2024-01-01</creationDate>
  <copyright>(C) 2023 - 2024  Bram Brambring</copyright>
  <license>GNU General Public License version 3 or later</license>
  <authorEmail>bram@brokenlinkchecker.dev</authorEmail>
  <authorUrl>brambring.nl</authorUrl>
  <version>24.44.dev</version>
  <description>PLG_BLC_CONTENT_XML_DESCRIPTION</description>
  <namespace path="src">Blc\Plugin\Blc\Content</namespace>
  <scriptfile>script.php</scriptfile>
  <languages folder="language">
    <language tag="de-DE">de-DE/plg_blc_content.sys.ini</language>
    <language tag="en-GB">en-GB/plg_blc_content.ini</language>
    <language tag="en-GB">en-GB/plg_blc_content.sys.ini</language>
    <language tag="nl-NL">nl-NL/plg_blc_content.ini</language>
    <language tag="nl-NL">nl-NL/plg_blc_content.sys.ini</language>
  </languages>
  <files>
    <folder plugin="content">services</folder>
    <folder>src</folder>
  </files>
  <config>
    <fields name="params">
      <fieldset name="basic" addfieldprefix="Blc\Component\Blc\Administrator\Field">
        <field name="check_catid" type="radio" default="1" layout="joomla.form.field.radio.switcher" filter="integer" label="PLG_BLC_CONTENT_FIELD_CHECK_CATID_LBL" description="PLG_BLC_CONTENT_FIELD_CHECK_CATID_DESC">
          <option value="0">JOff</option>
          <option value="1">JOn</option>
        </field>
        <field name="article_alias" type="list" default="0" filter="integer" label="PLG_BLC_CONTENT_FIELD_ARTICLE_ALIAS_LBL" description="PLG_BLC_CONTENT_FIELD_ARTICLE_ALIAS_DESC">
          <option value="0">PLG_BLC_CONTENT_FIELD_ARTICLE_ALIAS_0_OPTION</option>
          <option value="1">PLG_BLC_CONTENT_FIELD_ARTICLE_ALIAS_1_OPTION</option>
          <option value="2">PLG_BLC_CONTENT_FIELD_ARTICLE_ALIAS_2_OPTION</option>
        </field>
        <field name="category_alias" showon="check_catid:1" type="list" default="0" filter="integer" label="PLG_BLC_CONTENT_FIELD_CATEGORY_ALIAS_LBL" description="PLG_BLC_CONTENT_FIELD_CATEGORY_ALIAS_DESC">
          <option value="0">PLG_BLC_CONTENT_FIELD_CATEGORY_ALIAS_0_OPTION</option>
          <option value="1">PLG_BLC_CONTENT_FIELD_CATEGORY_ALIAS_1_OPTION</option>
          <option value="2">PLG_BLC_CONTENT_FIELD_CATEGORY_ALIAS_2_OPTION</option>
        </field>
        <field name="info" type="Info" tag="p" class="Blc\Plugin\Blc\Content\Extension\BlcPluginActor"/>
      </fieldset>
      <fieldset name="customfields">
        <field name="enablecf" type="radio" default="0" layout="joomla.form.field.radio.switcher" filter="integer" label="PLG_BLC_CONTENT_FIELD_ENABLECF_LBL" description="PLG_BLC_CONTENT_FIELD_ENABLECF_DESC">
          <option value="0">JOff</option>
          <option value="1">JOn</option>
        </field>
        <field name="cf" showon="enablecf:1" formsource="administrator/components/com_blc/forms/cffields.xml" id="com_content.article" type="subform" label="PLG_BLC_CONTENT_FIELD_CF_LBL" description="PLG_BLC_CONTENT_FIELD_CF_DESC"/>
        <field name="info" type="Info" tag="p" class="Blc\Plugin\Blc\Content\Extension\BlcPluginActor"/>
      </fieldset>
      <fieldset name="advanced">
        <field name="access" type="list" label="COM_BLC_PLUGIN_ACCESS_LBL" default="-1" filter="integer" description="COM_BLC_PLUGIN_ACCESS_DESC">
          <option value="-1">JGLOBAL_USE_GLOBAL</option>
          <option value="0">JOff</option>
          <option value="1">JOn</option>
        </field>
        <field name="published" type="list" label="COM_BLC_PLUGIN_PUBLISHED_LBL" default="-1" filter="integer" description="COM_BLC_PLUGIN_PUBLISHED_DESC">
          <option value="-1">JGLOBAL_USE_GLOBAL</option>
          <option value="0">JOff</option>
          <option value="1">JOn</option>
        </field>
        <field name="onsave" type="list" label="COM_BLC_PLUGIN_ONSAVE_LBL" default="default" description="COM_BLC_PLUGIN_ONSAVE_LBL_DESC">
          <option value="-1">JGLOBAL_USE_GLOBAL</option>
          <option value="parse">COM_BLC_PLUGIN_DO_PARSE</option>
          <option value="delete">COM_BLC_PLUGIN_DO_DELETE</option>
          <option value="nothing">COM_BLC_PLUGIN_DO_NOTHING</option>
        </field>
        <field name="ondelete" type="list" label="COM_BLC_PLUGIN_ONDELETE_LBL" default="default" description="COM_BLC_PLUGIN_ONDELETE_DESC">
          <option value="-1">JGLOBAL_USE_GLOBAL</option>
          <option value="delete">COM_BLC_PLUGIN_DO_DELETE</option>
          <option value="nothing">COM_BLC_PLUGIN_DO_NOTHING</option>
        </field>
        <field name="deleteonsavepugin" filter="integer" default="-1" type="list" label="COM_BLC_PLUGIN_DELETEONSAVEPUGIN_LBL" description="COM_BLC_PLUGIN_DELETEONSAVEPUGIN_DESC">
          <option value="-1">JGLOBAL_USE_GLOBAL</option>
          <option value="0">JOff</option>
          <option value="1">JOn</option>
        </field>
        <field name="info" type="Info" tag="p" class="Blc\Plugin\Blc\Content\Extension\BlcPluginActor"/>
      </fieldset>
    </fields>
  </config>
</extension>
